          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="06 - Logout" enabled="true">
          <stringProp name="TestPlan.comments">Follows the redirect back to /login</stringProp>
          <stringProp name="HTTPSampler.path">/logout</stringProp>
