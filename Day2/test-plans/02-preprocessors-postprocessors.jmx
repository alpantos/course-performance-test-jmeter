<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor (Groovy)" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">// slide 20: generate a random userID before the request is sent
vars.put('userID', 'U' + (1000 + new Random().nextInt(9000)))
vars.put('itemLabel', vars.get('itemName') + '-' + vars.get('userID'))
log.info('JSR223 pre: itemLabel=' + vars.get('itemLabel'))</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223PreProcessor>
<hashTree></hashTree>
