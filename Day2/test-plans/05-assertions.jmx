<hashTree><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion (Groovy)" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="filename"></stringProp><stringProp name="parameters"></stringProp><stringProp name="script">import groovy.json.JsonSlurper
def item = new JsonSlurper().parseText(prev.getResponseDataAsString())
if (item.price &lt;= 0 || item.stock &lt; 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Invalid price/stock for item ' + item.id)
}</stringProp><stringProp name="scriptLanguage">groovy</stringProp></JSR223Assertion>
<hashTree></hashTree>
</hashTree>
